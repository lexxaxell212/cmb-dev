 /etc/systemd/system/api-coffee.service
[Unit]
Description=Egi-Coffee API (Express + MongoDB)
After=network.target mongod.service

[Service]
Type=simple
User=lexx
WorkingDirectory=/home/lexx/cmb-dev/api-coffee
EnvironmentFile=/home/lexx/cmb-dev/api-coffee/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
