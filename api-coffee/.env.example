# Port server API
PORT=3001

# Host binding. Biarkan 127.0.0.1 agar API hanya bisa diakses lewat reverse proxy (Nginx) di server yang sama.
# Ubah ke 0.0.0.0 hanya jika ingin API bisa diakses langsung dari luar.
HOST=127.0.0.1

# MongoDB connection string (format: mongodb://user:pass@host:port/db)
MONGO_URI=mongodb://127.0.0.1:27017/egycoffee

# --- AUTH ---
# Rahasia untuk menandatangani token JWT. GANTI dengan string acak yang panjang!
# Contoh membuat: openssl rand -hex 32
JWT_SECRET=

# Admin pertama dibuat otomatis saat server pertama kali dinyalakan
# (hanya jika username tersebut belum ada di MongoDB).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Masa berlaku token (mis. 2h, 8h, 1d)
JWT_EXPIRES_IN=2h

# Daftar origin yang diizinkan (pisahkan dengan koma) — gunakan * untuk semua
CORS_ORIGIN=*